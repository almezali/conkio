import { ListView, ScrollView } from "std-widgets.slint";

export struct ThemeRow { name: string, path: string, running: bool, favorite: bool, health: string, checked: bool }
export struct OnlineProduct { id: int, name: string, subtitle: string }

// ─────────────────────────────────────────────────────────────
//  Design tokens (dark / light) — shared by every window
// ─────────────────────────────────────────────────────────────
export global Pal {
    in-out property <bool> light-mode: false;
    out property <color> bg: light-mode ? #eef2f8 : #070d19;
    out property <color> sidebar: light-mode ? #e3e9f2 : #0a1222;
    out property <color> surface: light-mode ? #ffffff : #0e182b;
    out property <color> surface-2: light-mode ? #f2f5fa : #131f36;
    out property <color> border: light-mode ? #d2dbe7 : #1c2b46;
    out property <color> text: light-mode ? #0f1d33 : #eef4ff;
    out property <color> text-dim: light-mode ? #4a617a : #9fb1cc;
    out property <color> text-faint: light-mode ? #7b8fa6 : #6a7f9c;
    out property <color> accent: light-mode ? #0891b2 : #22d3ee;
    out property <color> success: light-mode ? #059669 : #34d399;
    out property <color> warn: light-mode ? #d97706 : #fbbf24;
    out property <color> danger: light-mode ? #dc2626 : #f87171;
    out property <color> overlay: light-mode ? #00000012 : #ffffff14;
    out property <brush> accent-grad: @linear-gradient(135deg, #22d3ee 0%, #6366f1 100%);
}

// ─────────────────────────────────────────────────────────────
//  Reusable building blocks
// ─────────────────────────────────────────────────────────────
component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> kind: "secondary"; // primary | secondary | danger | ghost
    in property <bool> enabled: true;
    in property <bool> icon-only: false;
    callback clicked;

    height: 38px;
    min-width: root.icon-only ? 38px : lay.min-width;
    preferred-width: root.icon-only ? 38px : lay.preferred-width;
    opacity: root.enabled ? 1.0 : 0.38;

    Rectangle {
        border-radius: 10px;
        background: root.kind == "danger" ? Pal.danger.with-alpha(0.14)
            : (root.kind == "ghost" ? transparent : Pal.surface-2);
        border-width: root.kind == "secondary" ? 1px : 0px;
        border-color: Pal.border;
    }
    if root.kind == "primary" : Rectangle { border-radius: 10px; background: Pal.accent-grad; }
    Rectangle {
        border-radius: 10px;
        background: ta.pressed ? Pal.overlay : (ta.has-hover && root.enabled ? Pal.overlay.with-alpha(0.08) : transparent);
    }
    lay := HorizontalLayout {
        padding-left: root.icon-only ? 0px : 14px;
        padding-right: root.icon-only ? 0px : 14px;
        spacing: 7px;
        alignment: center;
        if root.icon != "" : Text {
            text: root.icon;
            font-size: 14px;
            vertical-alignment: center;
            color: root.kind == "primary" ? #04111e : (root.kind == "danger" ? Pal.danger : Pal.accent);
        }
        if root.text != "" && !root.icon-only : Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.kind == "primary" ? #04111e : (root.kind == "danger" ? Pal.danger : Pal.text);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Pal.accent;
    height: 22px;
    border-radius: 11px;
    background: root.tint.with-alpha(0.16);
    min-width: clay.min-width;
    preferred-width: clay.preferred-width;
    clay := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text { text: root.text; color: root.tint; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <bool> rail;
    callback clicked;
    height: 44px;
    border-radius: 12px;
    background: root.active ? Pal.accent.with-alpha(0.14) : (ta.has-hover ? Pal.overlay : transparent);
    animate background { duration: 120ms; }
    if root.active : Rectangle {
        x: 0px; y: (parent.height - self.height) / 2;
        width: 3px; height: 22px; border-radius: 2px;
        background: Pal.accent-grad;
    }
    HorizontalLayout {
        padding-left: root.rail ? 0px : 16px;
        spacing: 13px;
        alignment: root.rail ? center : start;
        Text { text: root.icon; width: 20px; font-size: 16px; color: root.active ? Pal.accent : Pal.text-dim; horizontal-alignment: center; vertical-alignment: center; }
        if !root.rail : Text { text: root.label; font-size: 14px; font-weight: root.active ? 700 : 500; color: root.active ? Pal.text : Pal.text-dim; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback accepted(string);
    height: 38px;
    border-radius: 10px;
    background: Pal.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Pal.accent : Pal.border;
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: "⌕"; font-size: 17px; color: Pal.text-faint; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                text <=> root.text;
                color: Pal.text;
                font-size: 13px;
                vertical-alignment: center;
                selection-background-color: Pal.accent.with-alpha(0.35);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if root.text == "" : Text {
                text: root.placeholder;
                color: Pal.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                x: 0px;
            }
        }
        if root.text != "" : Rectangle {
            width: 24px;
            Text { text: "✕"; font-size: 11px; color: Pal.text-faint; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.text = ""; root.edited(""); } }
        }
    }
}

component EmptyState inherits Rectangle {
    in property <string> icon: "◈";
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 24px;
        Rectangle {
            width: 76px; height: 76px; border-radius: 38px;
            background: Pal.accent.with-alpha(0.12);
            border-width: 1px; border-color: Pal.accent.with-alpha(0.35);
            Text { text: root.icon; font-size: 32px; color: Pal.accent; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: root.title; font-size: 18px; font-weight: 700; color: Pal.text; horizontal-alignment: center; }
        Text { text: root.subtitle; font-size: 12px; color: Pal.text-dim; horizontal-alignment: center; wrap: word-wrap; }
        @children
    }
}

component ThemeItem inherits Rectangle {
    in property <ThemeRow> item;
    in property <bool> selected;
    callback clicked;
    callback favorite-clicked;
    callback checked-changed(bool);
    callback context-menu;
    in-out property <bool> checked: item.checked;
    width: 100%;
    height: 72px;

    property <color> health-tint:
        (item.health == "Stable" || item.health == "stable" || item.health == "OK" || item.health == "Healthy") ? Pal.success
        : ((item.health == "Needs fix" || item.health == "needs-fix" || item.health == "Needs-fix" || item.health == "needs fix" || item.health == "Needs Fix") ? Pal.warn
        : ((item.health == "Broken" || item.health == "broken") ? Pal.danger : Pal.text-faint));

    card := Rectangle {
        y: 0px;
        width: 100%;
        height: 66px;
        border-radius: 11px;
        background: area.has-hover ? Pal.surface-2 : Pal.surface;
        border-width: 1px;
        border-color: area.has-hover ? Pal.accent.with-alpha(0.55) : Pal.border;
        animate background { duration: 120ms; }
        area := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.context-menu(); }
            }
        }
        HorizontalLayout {
            padding: 8px; padding-left: 10px; padding-right: 10px;
            spacing: 7px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px; height: 24px; border-radius: 6px;
                    background: root.checked ? Pal.accent : transparent;
                    border-width: 1px; border-color: root.checked ? Pal.accent : Pal.border;
                    Text { text: root.checked ? "✓" : ""; color: #FFFFFF; font-size: 15px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.checked = !root.checked; root.checked-changed(root.checked); } }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px; height: 36px; border-radius: 10px;
                    background: root.item.running ? Pal.success.with-alpha(0.16) : Pal.accent.with-alpha(0.12);
                    Text {
                        text: root.item.running ? "●" : "◈";
                        font-size: root.item.running ? 16px : 22px;
                        color: root.item.running ? Pal.success : Pal.accent;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;
                Text { text: root.item.name; color: Pal.text; font-size: 13px; font-weight: 700; overflow: elide; }
                Text { text: root.item.path; color: Pal.text-faint; font-size: 10px; overflow: elide; }
            }
            if root.item.running : VerticalLayout { alignment: center; Chip { text: "RUNNING"; tint: Pal.success; } }
            if root.item.health != "" : VerticalLayout { alignment: center; Chip { text: root.item.health; tint: root.health-tint; } }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 19px;
                    background: star.has-hover ? Pal.warn.with-alpha(0.15) : transparent;
                    Text { text: root.item.favorite ? "★" : "☆"; font-size: 21px; color: root.item.favorite ? Pal.warn : Pal.text-faint; horizontal-alignment: center; vertical-alignment: center; }
                    star := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.favorite-clicked(); } }
                }
            }
        }
    }
}

component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(int);
    height: 38px;
    min-width: 130px;
    preferred-width: 170px;
    border-radius: 10px;
    background: Pal.surface-2;
    border-width: 1px;
    border-color: ta.has-hover ? Pal.accent : Pal.border;
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.model[root.current-index]; color: Pal.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: "▾"; color: Pal.text-faint; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { popup.show(); } }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 36px + 8px;
        Rectangle {
            background: Pal.surface;
            border-radius: 12px;
            border-width: 1px;
            border-color: Pal.border;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.model : Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: i == root.current-index ? Pal.accent.with-alpha(0.16) : (opt.has-hover ? Pal.overlay : transparent);
                    Text { x: 12px; text: item; color: i == root.current-index ? Pal.accent : Pal.text; font-size: 13px; vertical-alignment: center; overflow: elide; width: parent.width - 24px; }
                    opt := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.current-index = i; root.selected(i); } }
                }
            }
        }
    }
}

component ProductRow inherits Rectangle {
    in property <OnlineProduct> item;
    in property <bool> selected;
    callback clicked;
    height: 76px;
    card := Rectangle {
        y: 0px;
        height: 68px;
        border-radius: 14px;
        background: root.selected ? Pal.accent.with-alpha(0.10) : (area.has-hover ? Pal.surface-2 : Pal.surface);
        border-width: root.selected ? 1.5px : 1px;
        border-color: root.selected ? Pal.accent : Pal.border;
        animate background { duration: 120ms; }
        area := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
        HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 42px; height: 42px; border-radius: 12px;
                    background: Pal.accent-grad;
                    Text { text: "✦"; font-size: 20px; color: #04111e; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: root.item.name; color: Pal.text; font-size: 14px; font-weight: 700; overflow: elide; }
                Text { text: root.item.subtitle; color: Pal.text-faint; font-size: 11px; overflow: elide; }
            }
        }
    }
}

component ProductList inherits Rectangle {
    in property <[OnlineProduct]> products;
    in property <int> selected-index;
    in property <bool> loading;
    callback select(int);
    ListView {
        for p[i] in root.products : ProductRow {
            item: p;
            selected: root.selected-index == i;
            clicked => { root.select(i); }
        }
    }
    if root.products.length == 0 : EmptyState {
        icon: "✦";
        title: root.loading ? "Searching…" : "No themes found";
        subtitle: root.loading ? "Contacting the store catalog." : "Try another store, category, or search keyword.";
    }
}

component DetailsPane inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> meta;
    in property <string> link-label;
    in property <string> link-url;
    in property <image> preview;
    in property <bool> has-preview;
    callback open-link(string);
    background: Pal.surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: Pal.border;
    ScrollView {
        content-width: self.width;
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            Text { text: root.title; color: Pal.text; font-size: 17px; font-weight: 800; wrap: word-wrap; }
            Rectangle {
                height: 180px;
                border-radius: 12px;
                background: Pal.surface-2;
                clip: true;
                if !root.has-preview : Text { text: "✦"; font-size: 44px; color: Pal.text-faint; horizontal-alignment: center; vertical-alignment: center; }
                if root.has-preview : Image { source: root.preview; image-fit: contain; width: parent.width; height: parent.height; }
            }
            Text { text: root.desc; color: Pal.text-dim; font-size: 12px; wrap: word-wrap; }
            if root.meta != "" : Text { text: root.meta; color: Pal.text; font-size: 12px; wrap: word-wrap; }
            Text { text: "Installation is performed only after selecting Download & Install. Files are placed in ~/.conky and can be scanned immediately."; color: Pal.text-faint; font-size: 11px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start;
                AppButton { text: root.link-label; icon: "↗"; clicked => { root.open-link(root.link-url); } }
            }
        }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? Pal.accent : Pal.border;
    animate background { duration: 140ms; }
    Rectangle {
        x: root.checked ? 22px : 2px;
        y: 3px;
        width: 20px; height: 20px; border-radius: 10px;
        background: #ffffff;
        animate x { duration: 140ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 66px;
    border-radius: 14px;
    background: Pal.surface;
    border-width: 1px;
    border-color: Pal.border;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; color: Pal.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.subtitle != "" : Text { text: root.subtitle; color: Pal.text-faint; font-size: 11px; overflow: elide; }
        }
        VerticalLayout { alignment: center; @children }
    }
}

component PageCard inherits Rectangle {
    background: Pal.surface;
    border-radius: 18px;
    border-width: 1px;
    border-color: Pal.border;
}

// ─────────────────────────────────────────────────────────────
//  Marketplace window (mirrors the Conky Manager GTK marketplace)
// ─────────────────────────────────────────────────────────────
export component MarketplaceWindow inherits Window {
    title: "Theme Marketplace";
    min-width: 560px;
    min-height: 480px;
    preferred-width: 1040px;
    preferred-height: 720px;
    background: Pal.bg;

    in-out property <bool> light-mode <=> Pal.light-mode;
    in property <[OnlineProduct]> products;
    in property <string> status-text: "Ready. Select a store or search for a theme.";
    in property <bool> loading: false;
    in property <bool> can-load-more: false;
    in-out property <int> selected-index: -1;
    in-out property <int> store-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <int> category-index: 0;
    in-out property <string> query;
    in property <string> detail-title: "Select a theme";
    in property <string> detail-desc: "Choose a result to inspect its description, author, version, and store page.";
    in property <string> detail-meta;
    in property <string> link-label: "Open store in browser";
    in property <string> link-url;
    in property <image> preview;
    in property <bool> has-preview: false;
    // Labels — the order must match ONLINE_STORES / SORT_IDS / CATEGORY_QUERIES in main.rs
    in property <[string]> stores: ["GNOME-Look.org", "KDE-Look.org", "Pling.com", "OpenDesktop.org"];
    in property <[string]> sorts: ["Most downloaded", "Recently updated", "Best rated"];
    in property <[string]> categories: ["All categories", "Minimal", "System Monitor", "Weather", "Music", "Network", "CPU/GPU", "Dark", "Light"];
    callback store-changed(int);
    callback sort-changed(int);
    callback category-changed(int);
    callback search(string);
    callback search-edited(string);
    callback select-product(int);
    callback load-more;
    callback install-selected;
    callback open-link(string);
    callback close-marketplace;

    property <bool> narrow: false;
    init => { root.narrow = root.width < 900px; }
    changed width => { root.narrow = root.width < 900px; }

    Rectangle {
        x: parent.width - 460px; y: -220px; width: 700px; height: 700px;
        background: @radial-gradient(circle, #6366f126 0%, #6366f100 70%);
    }
    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        VerticalLayout {
            spacing: 3px;
            Text { text: "Conky Theme Marketplace"; color: Pal.text; font-size: 26px; font-weight: 800; overflow: elide; }
            Text { text: "Search real store catalogs, inspect metadata, and install directly into ~/.conky."; color: Pal.text-dim; font-size: 12px; overflow: elide; }
        }

        if !root.narrow : HorizontalLayout {
            spacing: 10px;
            Dropdown { model: root.stores; current-index <=> root.store-index; selected(i) => { root.store-changed(i); } }
            Dropdown { model: root.sorts; current-index <=> root.sort-index; selected(i) => { root.sort-changed(i); } }
            Dropdown { model: root.categories; current-index <=> root.category-index; selected(i) => { root.category-changed(i); } }
            SearchField {
                horizontal-stretch: 1;
                min-width: 160px;
                placeholder: "Search themes, authors, or keywords…";
                text <=> root.query;
                edited(t) => { root.search-edited(t); }
                accepted(t) => { root.search(t); }
            }
        }
        if root.narrow : VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                Dropdown { model: root.stores; current-index <=> root.store-index; selected(i) => { root.store-changed(i); } }
                Dropdown { model: root.sorts; current-index <=> root.sort-index; selected(i) => { root.sort-changed(i); } }
                Dropdown { model: root.categories; current-index <=> root.category-index; selected(i) => { root.category-changed(i); } }
            }
            SearchField {
                placeholder: "Search themes, authors, or keywords…";
                text <=> root.query;
                edited(t) => { root.search-edited(t); }
                accepted(t) => { root.search(t); }
            }
        }

        Rectangle {
            height: 34px;
            border-radius: 10px;
            background: Pal.accent.with-alpha(0.10);
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 9px;
                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.loading ? Pal.warn : Pal.accent; y: (parent.height - self.height) / 2; }
                Text { text: root.status-text; color: Pal.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
        }

        if !root.narrow : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;
            ProductList {
                horizontal-stretch: 1;
                products: root.products;
                selected-index: root.selected-index;
                loading: root.loading;
                select(i) => { root.select-product(i); }
            }
            DetailsPane {
                width: 370px;
                title: root.detail-title; desc: root.detail-desc; meta: root.detail-meta;
                link-label: root.link-label; link-url: root.link-url;
                preview: root.preview; has-preview: root.has-preview;
                open-link(u) => { root.open-link(u); }
            }
        }
        if root.narrow : VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            ProductList {
                vertical-stretch: 1;
                products: root.products;
                selected-index: root.selected-index;
                loading: root.loading;
                select(i) => { root.select-product(i); }
            }
            DetailsPane {
                height: 250px;
                title: root.detail-title; desc: root.detail-desc; meta: root.detail-meta;
                link-label: root.link-label; link-url: root.link-url;
                preview: root.preview; has-preview: root.has-preview;
                open-link(u) => { root.open-link(u); }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            AppButton { text: "Load more results"; icon: "⇣"; enabled: root.can-load-more && !root.loading; clicked => { root.load-more(); } }
            Rectangle { horizontal-stretch: 1; }
            AppButton { text: "Close"; icon: "✕"; clicked => { root.close-marketplace(); } }
            AppButton { text: "Download & Install"; icon: "⇩"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.install-selected(); } }
        }
    }
}

// ─────────────────────────────────────────────────────────────
//  Download progress window
// ─────────────────────────────────────────────────────────────
export component DownloadWindow inherits Window {
    title: "Downloading Theme";
    min-width: 420px;
    min-height: 200px;
    preferred-width: 500px;
    preferred-height: 220px;
    background: Pal.bg;

    in-out property <bool> light-mode <=> Pal.light-mode;
    in property <string> item-title;
    in property <float> progress: 0;
    in property <string> status-text: "Connecting…";
    callback cancel;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text { text: root.item-title; color: Pal.text; font-size: 18px; font-weight: 800; overflow: elide; }
        Rectangle {
            height: 22px;
            border-radius: 11px;
            background: Pal.surface-2;
            border-width: 1px;
            border-color: Pal.border;
            clip: true;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(root.progress, 0, 1);
                background: Pal.accent-grad;
                animate width { duration: 120ms; easing: ease-out; }
            }
            Text { text: Math.round(clamp(root.progress, 0, 1) * 100) + "%"; font-size: 11px; font-weight: 700; color: Pal.text; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: root.status-text; color: Pal.text-dim; font-size: 12px; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            AppButton { text: "Cancel"; icon: "✕"; kind: "danger"; clicked => { root.cancel(); } }
        }
    }
}

// ─────────────────────────────────────────────────────────────
//  Settings window
// ─────────────────────────────────────────────────────────────
export component SettingsWindow inherits Window {
    title: "Conkio Settings";
    min-width: 440px;
    min-height: 440px;
    preferred-width: 620px;
    preferred-height: 540px;
    background: Pal.bg;

    in-out property <bool> light-mode <=> Pal.light-mode;
    in property <string> theme-directory;
    in property <string> desktop-info;
    in-out property <string> layer: "above";
    in-out property <string> window-type: "dock";
    in-out property <string> smoothness: "balanced";
    in-out property <string> desktop-preset: "auto";
    in-out property <int> nice-level: 10;
    in-out property <int> max-instances: 8;
    in-out property <int> preview-seconds: 5;
    in property <[string]> layer-options: ["above", "below"];
    in property <[string]> window-type-options: ["dock", "desktop", "normal", "override"];
    in property <[string]> smoothness-options: ["ultra", "balanced", "performance"];
    in property <[string]> desktop-options: ["auto", "kde", "gnome", "xfce", "cinnamon", "mate", "lxqt", "lxde", "hyprland", "niri", "sway", "cosmic", "generic"];
    in-out property <bool> login-autostart;
    in-out property <bool> minimize-to-tray;
    callback close-settings;
    callback save-settings;
    callback appearance-changed(bool); // true = light
    callback add-theme-folder;
    callback login-toggled(bool);
    callback tray-toggled(bool);

    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
        padding: 28px;
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            Text { text: "Settings"; color: Pal.text; font-size: 28px; font-weight: 800; }
            Text { text: "Personalize Conkio and manage its Linux integration."; color: Pal.text-dim; font-size: 12px; overflow: elide; }
        }
        Rectangle { height: 8px; }
        SettingRow {
            title: "Appearance";
            subtitle: "Choose between the dark and light interface";
            Rectangle {
                width: 150px; height: 34px; border-radius: 10px;
                background: Pal.surface-2;
                border-width: 1px; border-color: Pal.border;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    Rectangle {
                        border-radius: 8px;
                        background: !Pal.light-mode ? Pal.accent.with-alpha(0.22) : transparent;
                        Text { text: "☾  Dark"; font-size: 12px; font-weight: 600; color: !Pal.light-mode ? Pal.accent : Pal.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Pal.light-mode = false; root.appearance-changed(false); } }
                    }
                    Rectangle {
                        border-radius: 8px;
                        background: Pal.light-mode ? Pal.accent.with-alpha(0.22) : transparent;
                        Text { text: "☀  Light"; font-size: 12px; font-weight: 600; color: Pal.light-mode ? Pal.accent : Pal.text-dim; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { Pal.light-mode = true; root.appearance-changed(true); } }
                    }
                }
            }
        }
        SettingRow {
            title: "Theme folder";
            subtitle: root.theme-directory;
            AppButton { text: "Add folder"; clicked => { root.add-theme-folder(); } }
        }
        SettingRow {
            title: "Desktop environment / window manager";
            subtitle: root.desktop-info;
            Dropdown { model: root.desktop-options; current-index: 0; selected(i) => { root.desktop-preset = root.desktop-options[i]; } }
        }
        SettingRow {
            title: "Conky window behavior";
            subtitle: "Layer and window type used when launching themes";
            HorizontalLayout {
                spacing: 6px;
                Dropdown { model: root.layer-options; current-index: 0; selected(i) => { root.layer = root.layer-options[i]; } }
                Dropdown { model: root.window-type-options; current-index: 0; selected(i) => { root.window-type = root.window-type-options[i]; } }
            }
        }
        SettingRow {
            title: "Performance and preview";
            subtitle: "Smoothness, process priority, instance limit and preview duration";
            HorizontalLayout {
                spacing: 6px;
                Dropdown { model: root.smoothness-options; current-index: 0; selected(i) => { root.smoothness = root.smoothness-options[i]; } }
                Text { text: "Nice: " + root.nice-level; color: Pal.text-dim; vertical-alignment: center; }
                AppButton { text: "−"; clicked => { root.nice-level = max(-5, root.nice-level - 1); } }
                AppButton { text: "+"; clicked => { root.nice-level = min(19, root.nice-level + 1); } }
                Text { text: "Max: " + root.max-instances; color: Pal.text-dim; vertical-alignment: center; }
                AppButton { text: "−"; clicked => { root.max-instances = max(1, root.max-instances - 1); } }
                AppButton { text: "+"; clicked => { root.max-instances = min(16, root.max-instances + 1); } }
            }
        }
        SettingRow {
            title: "Start Conky themes with desktop session";
            subtitle: "Launch the last profile automatically at login";
            Toggle { checked <=> root.login-autostart; toggled(v) => { root.login-toggled(v); } }
        }
        SettingRow {
            title: "Minimize Conkio to the system tray";
            subtitle: "Keep Conkio running quietly in the background";
            Toggle { checked <=> root.minimize-to-tray; toggled(v) => { root.tray-toggled(v); } }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            AppButton { text: "Cancel"; clicked => { root.close-settings(); } }
            Rectangle { horizontal-stretch: 1; }
            AppButton { text: "Save settings"; icon: "✓"; kind: "primary"; clicked => { root.save-settings(); } }
        }
        }
    }
}

// ─────────────────────────────────────────────────────────────
//  About window
// ─────────────────────────────────────────────────────────────
export component AboutWindow inherits Window {
    title: "About Conkio";
    min-width: 380px;
    min-height: 340px;
    preferred-width: 460px;
    preferred-height: 380px;
    background: Pal.bg;

    in-out property <bool> light-mode <=> Pal.light-mode;
    callback close-about;

    Rectangle {
        x: (parent.width - self.width) / 2; y: -160px; width: 560px; height: 560px;
        background: @radial-gradient(circle, #22d3ee2e 0%, #22d3ee00 70%);
    }
    VerticalLayout {
        padding: 30px;
        spacing: 12px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 86px; height: 86px; border-radius: 26px;
                background: Pal.accent-grad;
                Text { text: "C"; color: #04111e; font-size: 48px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text { text: "Conkio"; color: Pal.text; font-size: 34px; font-weight: 800; horizontal-alignment: center; }
        Text { text: "Your Desktop, Your Style."; color: Pal.accent; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
        Text { text: "A modern Linux manager for Conky themes.\nRust + Slint edition 1.0.1"; color: Pal.text-dim; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { alignment: center; AppButton { text: "Close"; kind: "primary"; clicked => { root.close-about(); } } }
    }
}

export component PromptWindow inherits Window {
    title: root.title-text;
    min-width: 360px;
    min-height: 180px;
    preferred-width: 420px;
    preferred-height: 200px;
    background: Pal.bg;
    in-out property <bool> light-mode <=> Pal.light-mode;
    in property <string> title-text: "Name";
    in property <string> prompt-label: "Name";
    in-out property <string> prompt-value;
    callback accepted(string);
    callback cancelled;
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Text { text: root.prompt-label; color: Pal.text; font-size: 16px; font-weight: 700; }
        SearchField { text <=> root.prompt-value; placeholder: "Type a name…"; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            AppButton { text: "Cancel"; clicked => { root.cancelled(); } }
            Rectangle { horizontal-stretch: 1; }
            AppButton { text: "OK"; kind: "primary"; clicked => { root.accepted(root.prompt-value); } }
        }
    }
}

// ─────────────────────────────────────────────────────────────
//  Main window
// ─────────────────────────────────────────────────────────────
export component ConkioWindow inherits Window {
    title: "Conkio";
    // Resizable + adaptive: preferred-* (not width/height) keeps the window freely resizable.
    min-width: 640px;
    min-height: 480px;
    preferred-width: 900px;
    preferred-height: 620px;
    background: Pal.bg;

    in-out property <string> page-title: "Themes";
    in property <string> status-text: "Ready";
    in property <string> conky-version: "Checking Conky…";
    in property <string> search-text;
    in property <[ThemeRow]> themes;
    in property <int> selected-index: -1;
    in-out property <bool> context-visible: false;
    in-out property <int> context-index: -1;
    in property <bool> busy;
    in property <bool> conky-installed;
    in-out property <bool> light-mode <=> Pal.light-mode;
    in property <bool> is-maximized: false; // optional: set from Rust to swap the icon
    in-out property <int> filter-index: 0;
    in property <string> details-text;
    in property <string> health-text;
    in property <string> backups-text;
    in property <string> desktop-info;
    in-out property <string> alignment: "top_left";
    in-out property <int> alignment-index: 0;
    in property <[string]> alignments: ["top_left", "top_middle", "top_right", "middle_left", "middle_middle", "middle_right", "bottom_left", "bottom_middle", "bottom_right"];
    in-out property <int> gap-x: 30;
    in-out property <int> gap-y: 50;
    in property <[string]> monitors;
    in-out property <int> monitor-index: 0;
    in-out property <string> color-text;
    in-out property <string> active-color-slot: "default_color";
    in property <[string]> palettes: ["Tokyo Night", "Dracula", "Nord", "Catppuccin Mocha", "Rosé Pine", "Gruvbox Dark", "Solarized Dark", "Everforest"];
    in-out property <int> palette-index: 0;
    in property <[string]> profiles;
    in-out property <int> profile-index: 0;
    callback refresh;
    callback import-folder;
    callback import-archive;
    callback run-selected;
    callback stop-selected;
    callback restart-selected;
    callback stop-all;
    callback remove-selected;
    callback toggle-favorite(int);
    callback check-theme(int, bool);
    callback context-theme(int);
    callback select-theme(int);
    callback search-changed(string);
    callback filter-changed(int);
    callback navigate(string);
    callback show-about;
    callback open-settings;
    callback open-marketplace;
    callback toggle-theme;
    callback backup-selected;
    callback export-selected;
    callback delete-selected;
    callback clone-selected;
    callback rename-selected;
    callback create-profile;
    callback run-profile;
    callback delete-profile;
    callback autostart-profile;
    callback apply-position;
    callback set-alignment(string);
    callback nudge(int, int);
    callback monitor-changed(int);
    callback apply-palette;
    callback pick-color;
    callback apply-colors;
    callback restore-backup;
    callback scan-health;
    callback repair-theme;
    callback files-dropped([string]);
    callback toggle-maximize;

    keyboard-focus := FocusScope {
        width: 1px;
        height: 1px;
        x: 0px;
        y: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.context-visible = false; return accept; }
            if (event.text == Key.Menu) { root.context-visible = true; return accept; }
            reject
        }
    }
    // ── adaptive layout ──
    property <bool> rail: false;                                      // sidebar collapsed to icons
    property <length> side-w: root.rail ? 76px : 232px;
    property <bool> labels: true;                                     // show button captions
    init => { root.rail = root.width < 860px; root.labels = (root.width - (root.rail ? 76px : 232px) - 52px) >= 720px; keyboard-focus.focus(); }
    changed width => { root.rail = root.width < 860px; root.labels = (root.width - (root.rail ? 76px : 232px) - 52px) >= 720px; }

    // soft background glow
    Rectangle {
        x: parent.width - 520px; y: -260px; width: 760px; height: 760px;
        background: @radial-gradient(circle, #6366f124 0%, #6366f100 70%);
    }
    Rectangle {
        x: root.side-w - 200px; y: parent.height - 360px; width: 560px; height: 560px;
        background: @radial-gradient(circle, #22d3ee16 0%, #22d3ee00 70%);
    }

    shell := Rectangle {
        width: 100%;
        height: 100%;
        HorizontalLayout {
            spacing: 0px;

            // ───────── Sidebar ─────────
            Rectangle {
                width: root.side-w;
                background: Pal.sidebar;
                animate width { duration: 180ms; easing: ease-out; }
                Rectangle { x: parent.width - 1px; width: 1px; background: Pal.border; }
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 52px;
                        spacing: 12px;
                        alignment: root.rail ? center : start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 42px; height: 42px; border-radius: 13px;
                                background: Pal.accent-grad;
                                Text { text: "C"; color: #04111e; font-size: 24px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        if !root.rail : VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text { text: "Conkio"; color: Pal.text; font-size: 21px; font-weight: 800; }
                            Text { text: "Desktop, your style"; color: Pal.text-faint; font-size: 10px; }
                        }
                    }
                    Rectangle { height: 14px; }
                    NavButton { label: "Themes"; icon: "◈"; rail: root.rail; active: root.page-title == "Themes"; clicked => { root.navigate("Themes"); } }
                    NavButton { label: "Running"; icon: "▶"; rail: root.rail; active: root.page-title == "Running"; clicked => { root.navigate("Running"); } }
                    NavButton { label: "Marketplace"; icon: "✦"; rail: root.rail; active: false; clicked => { root.open-marketplace(); } }
                    NavButton { label: "Health scan"; icon: "✚"; rail: root.rail; active: root.page-title == "Health"; clicked => { root.navigate("Health"); } }
                    NavButton { label: "Customize"; icon: "▦"; rail: root.rail; active: root.page-title == "Customize"; clicked => { root.navigate("Customize"); } }
                    NavButton { label: "Profiles"; icon: "☰"; rail: root.rail; active: root.page-title == "Profiles"; clicked => { root.navigate("Profiles"); } }
                    NavButton { label: "Details"; icon: "ⓘ"; rail: root.rail; active: root.page-title == "Details"; clicked => { root.navigate("Details"); } }
                    Rectangle { vertical-stretch: 1; }
                    NavButton { label: "Settings"; icon: "⚙"; rail: root.rail; active: false; clicked => { root.open-settings(); } }
                    NavButton { label: "About"; icon: "ⓘ"; rail: root.rail; active: false; clicked => { root.show-about(); } }
                    Rectangle { height: 1px; background: Pal.border; }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        alignment: root.rail ? center : start;
                        padding-left: root.rail ? 0px : 6px;
                        VerticalLayout { alignment: center; Rectangle { width: 9px; height: 9px; border-radius: 5px; background: root.conky-installed ? Pal.success : Pal.danger; } }
                        if !root.rail : Text { text: root.conky-installed ? "Conky available" : "Conky not found"; color: root.conky-installed ? Pal.success : Pal.danger; font-size: 11px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                    }
                }
            }

            // ───────── Content ─────────
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 26px;
                padding-top: 22px;
                spacing: 16px;

                // header
                HorizontalLayout {
                    height: 56px;
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text { text: root.page-title; color: Pal.text; font-size: 28px; font-weight: 800; overflow: elide; }
                        Text { text: root.busy ? "⏳  " + root.status-text : root.status-text; color: root.busy ? Pal.accent : Pal.text-faint; font-size: 12px; overflow: elide; }
                    }
                    if root.page-title == "Themes" : VerticalLayout {
                        alignment: center;
                        SearchField {
                            min-width: 130px;
                            preferred-width: 250px;
                            max-width: 300px;
                            placeholder: "Search themes…";
                            text: root.search-text;
                            edited(t) => { root.search-changed(t); }
                        }
                    }
                    if root.page-title == "Themes" : VerticalLayout { alignment: center; AppButton { text: "Folder"; icon: "▣"; icon-only: !root.labels; clicked => { root.import-folder(); } } }
                    if root.page-title == "Themes" : VerticalLayout { alignment: center; AppButton { text: "Archive"; icon: "▤"; icon-only: !root.labels; clicked => { root.import-archive(); } } }
                    VerticalLayout { alignment: center; AppButton { icon: Pal.light-mode ? "☾" : "☀"; icon-only: true; clicked => { root.toggle-theme(); } } }
                    VerticalLayout { alignment: center; AppButton { icon: "↻"; icon-only: true; clicked => { root.refresh(); } } }
                    VerticalLayout { alignment: center; AppButton { icon: root.is-maximized ? "❐" : "□"; icon-only: true; clicked => { root.toggle-maximize(); } } }
                }

                // busy bar
                if root.busy : Rectangle { height: 3px; border-radius: 2px; background: Pal.accent-grad; }

                if root.page-title == "Themes" : HorizontalLayout {
                    spacing: 6px;
                    AppButton { text: "All"; kind: root.filter-index == 0 ? "primary" : "ghost"; clicked => { root.filter-changed(0); } }
                    AppButton { text: "★ Favorites"; kind: root.filter-index == 1 ? "primary" : "ghost"; clicked => { root.filter-changed(1); } }
                    AppButton { text: "Running"; kind: root.filter-index == 2 ? "primary" : "ghost"; clicked => { root.filter-changed(2); } }
                    AppButton { text: "Recent"; kind: root.filter-index == 3 ? "primary" : "ghost"; clicked => { root.filter-changed(3); } }
                    AppButton { text: "Needs Fix"; kind: root.filter-index == 4 ? "primary" : "ghost"; clicked => { root.filter-changed(4); } }
                    AppButton { text: "Broken"; kind: root.filter-index == 5 ? "primary" : "ghost"; clicked => { root.filter-changed(5); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "Drop a folder or archive here to import."; color: Pal.text-faint; font-size: 11px; vertical-alignment: center; }
                }

                // ── Themes ──
                if root.page-title == "Themes" : Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for theme[index] in root.themes : ThemeItem {
                            item: theme;
                            selected: root.selected-index == index;
                            clicked => { root.select-theme(index); }
                            favorite-clicked => { root.toggle-favorite(index); }
                            checked-changed(v) => { root.check-theme(index, v); }
                            context-menu => { root.context-theme(index); }
                        }
                    }
                    if root.themes.length == 0 : EmptyState {
                        icon: "◈";
                        title: "No themes found";
                        subtitle: "Import a folder or an archive to add your first Conky theme.";
                    }
                }
                if root.context-visible : Rectangle {
                    width: 100%; height: 1px;
                    background: transparent;
                    TouchArea { clicked => { root.context-visible = false; } }
                }
                if root.context-visible : Rectangle {
                    width: 310px;
                    height: 210px;
                    border-radius: 14px;
                    background: Pal.surface;
                    border-width: 1px;
                    border-color: Pal.accent;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 5px;
                        Text { text: "Theme actions"; color: Pal.text; font-size: 14px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 5px;
                            AppButton { text: "Run"; kind: "primary"; clicked => { root.context-visible = false; root.run-selected(); } }
                            AppButton { text: "Stop"; clicked => { root.context-visible = false; root.stop-selected(); } }
                            AppButton { text: "Restart"; clicked => { root.context-visible = false; root.restart-selected(); } }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            AppButton { text: "Favorite"; clicked => { root.context-visible = false; root.toggle-favorite(root.context-index); } }
                            AppButton { text: "Backup"; clicked => { root.context-visible = false; root.backup-selected(); } }
                            AppButton { text: "Export"; clicked => { root.context-visible = false; root.export-selected(); } }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            AppButton { text: "Add to profile"; clicked => { root.context-visible = false; root.create-profile(); } }
                            AppButton { text: "Delete"; kind: "danger"; clicked => { root.context-visible = false; root.delete-selected(); } }
                        }
                    }
                }
                if root.page-title == "Themes" : Rectangle {
                    height: 62px;
                    border-radius: 16px;
                    background: Pal.surface;
                    border-width: 1px;
                    border-color: Pal.border;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        AppButton { text: "Backup"; icon: "⇩"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.backup-selected(); } }
                        AppButton { text: "Add to profile"; icon: "＋"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.create-profile(); } }
                        AppButton { text: "Export"; icon: "↗"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.export-selected(); } }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: "Run selected"; icon: "▶"; kind: "primary"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.run-selected(); } }
                        AppButton { text: "Run checked"; icon: "▶▶"; kind: "primary"; icon-only: !root.labels; clicked => { root.run-selected(); } }
                        AppButton { text: "Stop"; icon: "■"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.stop-selected(); } }
                        AppButton { text: "Restart"; icon: "↻"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.restart-selected(); } }
                        AppButton { text: "Delete"; icon: "✕"; kind: "danger"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.delete-selected(); } }
                    }
                }

                // ── Running ──
                if root.page-title == "Running" : Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for theme[index] in root.themes : Rectangle {
                            height: theme.running ? 84px : 0px;
                            visible: theme.running;
                            ThemeItem {
                                item: theme;
                                selected: root.selected-index == index;
                                clicked => { root.select-theme(index); }
                                favorite-clicked => { root.toggle-favorite(index); }
                            }
                        }
                    }
                    if root.themes.length == 0 : EmptyState {
                        icon: "▶";
                        title: "Running themes";
                        subtitle: "Start a theme and it will appear here.";
                    }
                }
                if root.page-title == "Running" : Rectangle {
                    height: 62px;
                    border-radius: 16px;
                    background: Pal.surface;
                    border-width: 1px;
                    border-color: Pal.border;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Text { text: "Active Conky processes are controlled safely from this page."; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        AppButton { text: "Stop all managed"; icon: "■"; kind: "danger"; icon-only: !root.labels; clicked => { root.stop-all(); } }
                        AppButton { text: "Stop selected theme"; icon: "■"; kind: "danger"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.stop-selected(); } }
                    }
                }

                // ── Health ──
                if root.page-title == "Health" : Rectangle {
                    vertical-stretch: 1;
                    ListView {
                        for theme[index] in root.themes : ThemeItem {
                            item: theme;
                            selected: root.selected-index == index;
                            clicked => { root.select-theme(index); }
                            favorite-clicked => { root.toggle-favorite(index); }
                            checked-changed(v) => { root.check-theme(index, v); }
                            context-menu => { root.context-theme(index); }
                        }
                    }
                    if root.themes.length == 0 : EmptyState {
                        icon: "✚";
                        title: "Theme health scan";
                        subtitle: "Stable, needs-fix and broken indicators are shown on every theme.";
                    }
                }
                if root.page-title == "Health" : Rectangle {
                    height: 62px;
                    border-radius: 16px;
                    background: Pal.surface;
                    border-width: 1px;
                    border-color: Pal.border;
                    HorizontalLayout {
                        padding: 12px;
                        Text { text: "Stable, needs-fix and broken indicators are shown on every theme."; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        AppButton { text: "Repair safely"; icon: "⚙"; kind: "primary"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.repair-theme(); } }
                        AppButton { text: "Deep scan selected"; icon: "✚"; icon-only: !root.labels; enabled: root.selected-index >= 0; clicked => { root.scan-health(); } }
                        AppButton { text: "Scan all themes"; icon: "↻"; icon-only: !root.labels; clicked => { root.refresh(); } }
                    }
                }

                // ── Customize ──
                if root.page-title == "Customize" : PageCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        Text { text: "Desktop placement"; color: Pal.text; font-size: 15px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout { spacing: 4px; Text { text: "Monitor"; color: Pal.text-dim; font-size: 11px; } Dropdown { model: root.monitors; current-index <=> root.monitor-index; selected(i) => { root.monitor-changed(i); } } }
                            VerticalLayout { spacing: 4px; Text { text: "Alignment"; color: Pal.text-dim; font-size: 11px; } Dropdown { model: root.alignments; current-index <=> root.alignment-index; selected(i) => { root.set-alignment(root.alignments[i]); } } }
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Text { text: "Gap X: " + root.gap-x; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                            AppButton { text: "−"; icon-only: true; clicked => { root.nudge(-10, 0); } }
                            AppButton { text: "+"; icon-only: true; clicked => { root.nudge(10, 0); } }
                            Text { text: "Gap Y: " + root.gap-y; color: Pal.text-dim; font-size: 12px; vertical-alignment: center; }
                            AppButton { text: "−"; icon-only: true; clicked => { root.nudge(0, -10); } }
                            AppButton { text: "+"; icon-only: true; clicked => { root.nudge(0, 10); } }
                        }
                        AppButton { text: "Apply position"; icon: "＋"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.apply-position(); } }
                        Text { text: "Color palette"; color: Pal.text; font-size: 15px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px;
                            Dropdown { model: root.palettes; current-index <=> root.palette-index; }
                            AppButton { text: "Apply palette"; icon: "▦"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.apply-palette(); } }
                            AppButton { text: "Pick color"; icon: "◍"; enabled: root.selected-index >= 0; clicked => { root.pick-color(); } }
                        }
                        Text { text: "Visual colors — click a swatch to edit that slot"; color: Pal.text; font-size: 15px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 7px;
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #A9B1D6; TouchArea { clicked => { root.active-color-slot = "default_color"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #7AA2F7; TouchArea { clicked => { root.active-color-slot = "color1"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #BB9AF7; TouchArea { clicked => { root.active-color-slot = "color2"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #7DCFFF; TouchArea { clicked => { root.active-color-slot = "color3"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #9ECE6A; TouchArea { clicked => { root.active-color-slot = "color4"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #E0AF68; TouchArea { clicked => { root.active-color-slot = "color5"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #F7768E; TouchArea { clicked => { root.active-color-slot = "color6"; root.pick-color(); } } }
                            Rectangle { width: 28px; height: 28px; border-radius: 7px; background: #C0CAF5; TouchArea { clicked => { root.active-color-slot = "color7"; root.pick-color(); } } }
                        }
                        Text { text: "Visual palette editor"; color: Pal.text-dim; font-size: 11px; }
                        Rectangle {
                            height: 54px; border-radius: 12px; background: Pal.surface-2; border-width: 1px; border-color: Pal.border;
                            HorizontalLayout { padding: 8px; spacing: 9px;
                                Text { text: "Click a swatch to choose its color"; color: Pal.text-dim; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.active-color-slot; color: Pal.accent; font-size: 11px; vertical-alignment: center; }
                                AppButton { text: "Choose color"; icon: "◍"; enabled: root.selected-index >= 0; clicked => { root.pick-color(); } }
                            }
                        }
                        AppButton { text: "Apply colors"; icon: "▦"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.apply-colors(); } }
                    }
                }
                // ── Details ──
                if root.page-title == "Details" : PageCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 12px;
                                Text { text: root.details-text; color: Pal.text; font-size: 12px; wrap: word-wrap; }
                                Text { text: root.health-text; color: Pal.text-dim; font-size: 12px; wrap: word-wrap; }
                                Text { text: "Backups:"; color: Pal.text; font-size: 13px; font-weight: 700; }
                                Text { text: root.backups-text; color: Pal.text-dim; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            AppButton { text: "Clone"; icon: "⧉"; enabled: root.selected-index >= 0; clicked => { root.clone-selected(); } }
                            AppButton { text: "Rename"; icon: "✎"; enabled: root.selected-index >= 0; clicked => { root.rename-selected(); } }
                            AppButton { text: "Restore latest backup"; icon: "↺"; enabled: root.selected-index >= 0; clicked => { root.restore-backup(); } }
                            AppButton { text: "Repair safely"; icon: "⚙"; enabled: root.selected-index >= 0; clicked => { root.repair-theme(); } }
                            AppButton { text: "Deep health scan"; icon: "✚"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.scan-health(); } }
                        }
                    }
                }
                // ── Profiles ──
                if root.page-title == "Profiles" : PageCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        EmptyState {
                            icon: "☰";
                            title: "Desktop profiles";
                            subtitle: "Save and restore groups of themes for different workflows.";
                            HorizontalLayout {
                                alignment: center;
                                padding-top: 6px;
                                AppButton { text: "Create profile from selected theme"; icon: "＋"; kind: "primary"; enabled: root.selected-index >= 0; clicked => { root.create-profile(); } }
                            }
                        }
                        Text { text: "Saved profiles"; color: Pal.text; font-size: 15px; font-weight: 700; }
                        HorizontalLayout {
                            spacing: 10px;
                            Dropdown { model: root.profiles; current-index <=> root.profile-index; }
                            AppButton { text: "Run profile"; icon: "▶"; kind: "primary"; enabled: root.profiles.length > 0; clicked => { root.run-profile(); } }
                            AppButton { text: "Autostart"; icon: "☀"; enabled: root.profiles.length > 0; clicked => { root.autostart-profile(); } }
                            AppButton { text: "Delete"; icon: "✕"; kind: "danger"; enabled: root.profiles.length > 0; clicked => { root.delete-profile(); } }
                        }
                    }
                }
            }
        }

}
}
